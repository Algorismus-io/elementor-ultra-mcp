{
  "name": "elementor-ultra-mcp",
  "version": "1.0.1",
  "private": true,
  "description": "The agent control surface for Elementor: an MCP server (~90 tools) + companion WordPress plugin that let AI agents read, build, refactor and govern real Elementor sites, with authoritative server-side validation, backups and rollback on every write.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "turbo run test:unit",
    "test:convert-corpus": "node scripts/convert-corpus.mjs",
    "fixtures:validate": "node scripts/fixtures-validate.mjs",
    "fixtures:snapshot-schemas": "node scripts/fixtures-snapshot-schemas.mjs",
    "wp-env": "wp-env",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "test:smoke": "pnpm --filter @elementor-ultra/server test:smoke",
    "test:contract": "pnpm --filter @elementor-ultra/server test:contract"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "@wordpress/env": "^10.10.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "license": "MIT",
  "author": "Algorismus <shahmir@algorismus.io> (https://algorismus.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algorismus-io/elementor-ultra-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Algorismus-io/elementor-ultra-mcp/issues"
  },
  "homepage": "https://github.com/Algorismus-io/elementor-ultra-mcp#readme",
  "keywords": [
    "ai-agents",
    "agent-native",
    "mcp",
    "model-context-protocol",
    "llm",
    "elementor",
    "wordpress",
    "claude",
    "cursor"
  ]
}

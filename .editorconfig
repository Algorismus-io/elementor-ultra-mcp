# EditorConfig — https://editorconfig.org
# Engineering Standards §2 (TS: LF, 2-space) and §3 (PHP: tabs).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PHP / WordPress Coding Standards use real tabs.
[*.php]
indent_style = tab
indent_size = 4

# Makefiles require tabs.
[Makefile]
indent_style = tab

# Markdown: keep trailing whitespace (hard line breaks).
[*.md]
trim_trailing_whitespace = false

{
  "//": "Copy to .mcp.json and fill in your site URL + an Application Password (Users → Profile → Application Passwords in wp-admin). .mcp.json is gitignored because it holds a credential.",
  "mcpServers": {
    "elementor-ultra": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/elementor-mcp/packages/server/dist/index.js"],
      "env": {
        "WP_URL": "http://localhost:8899",
        "WP_USER": "admin",
        "WP_APP_PASSWORD": "xxxx xxxx xxxx xxxx xxxx xxxx",
        "ULTRA_TOOLS": "full"
      }
    }
  }
}

{
  "name": "@elementor-ultra/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, JSON Schemas, and golden-tree fixtures (TS <-> PHP). Skeleton from WP-F01; populated by WP-F02/F03/F06.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "license": "MIT",
  "author": "Algorismus <shahmir@algorismus.io> (https://algorismus.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itshahmir/elementor-ultra-mcp.git"
  }
}

  "design_system": {
    "_comment": "M5: classes via the diff-PUT (10-rest-api.md §4.2) — FULL final `order`, EXPLICIT `changes.deleted`, `items` ONLY for added+modified, budget pre-flight (count(existing)−deleted+added ≤ 1000). The TS caller MUST GET /design/classes first to learn current ids+order before building this PUT (the scenario does). `seed_duplicate_label` drives the DUPLICATED_LABEL reconcile assertion: it adds a class whose label collides with an existing one so the handler returns a 200 with modified_labels (a soft outcome — the caller rebinds, never a hard error).",
    "classes": {
      "context": "frontend",
      "add": [
        {
          "id": "g-q7-hero",
          "type": "class",
          "label": "q7hero",
          "variants": [
            {
              "meta": { "breakpoint": "desktop", "state": null },
              "props": {
                "background": {
                  "$$type": "background",
                  "value": { "color": { "$$type": "color", "value": "rgb(8, 12, 24)" } }
                },
                "padding": {
                  "$$type": "dimensions",
                  "value": {
                    "block-start": { "$$type": "size", "value": { "unit": "px", "size": 96 } },
                    "block-end": { "$$type": "size", "value": { "unit": "px", "size": 96 } },
                    "inline-start": { "$$type": "size", "value": { "unit": "px", "size": 48 } },
                    "inline-end": { "$$type": "size", "value": { "unit": "px", "size": 48 } }
                  }
                }
              }
            }
          ]
        },
        {
          "id": "g-q7-cta",
          "type": "class",
          "label": "q7cta",
          "variants": [
            {
              "meta": { "breakpoint": "desktop", "state": null },
              "props": {
                "background": {
                  "$$type": "background",
                  "value": { "color": { "$$type": "color", "value": "rgb(255, 0, 128)" } }
                },
                "color": { "$$type": "color", "value": "rgb(255, 255, 255)" }
              }
            }
          ]
        },
        {
          "id": "g-q7-card",
          "type": "class",
          "label": "q7card",
          "variants": [
            {
              "meta": { "breakpoint": "desktop", "state": null },
              "props": {
                "background": {
                  "$$type": "background",
                  "value": { "color": { "$$type": "color", "value": "rgb(245, 245, 245)" } }
                }
              }
            }
          ]
        }
      ],
      "delete": [],
      "seed_duplicate_label": {
        "_comment": "A second class authored with the SAME label as g-q7-card (q7card) so the diff-PUT triggers the DUPLICATED_LABEL soft-reconcile path (200 + modified_labels, 10-rest-api.md §4.3). The scenario asserts modified_labels is non-empty and the renamed id is rebindable.",
        "id": "g-q7-card2",
        "type": "class",
        "label": "q7card",
        "variants": [
          {
            "meta": { "breakpoint": "desktop", "state": null },
            "props": {
              "color": { "$$type": "color", "value": "rgb(20, 20, 20)" }
            }
          }
        ]
      }
    },
    "variables": {
      "_comment": "M5 design-system: a watermarked atomic variables batch (10-rest-api.md §4.4). watermark is REQUIRED + read from GET /design/variables first; a stale watermark fails the whole batch (WATERMARK_STALE). All three types are FREE.",
      "operations": [
